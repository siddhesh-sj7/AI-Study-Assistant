{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AI Student Assistant",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local: (http://\\S+)",
        "uriFormat": "%s/index.html",
        "action": "openExternally"
      }
    }
  ]
}
